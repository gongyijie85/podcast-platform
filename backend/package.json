{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "Podcast Platform backend (NestJS)",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/backend/src/main.js",
    "start:prod": "node dist/backend/src/main.js",
    "lint": "eslint . --ext .ts",
    "test": "jest --config jest.config.ts",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed:bgm": "ts-node -r tsconfig-paths/register src/modules/bgm/bgm.seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/platform-socket.io": "^10.4.4",
    "@nestjs/websockets": "^10.4.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/config": "^3.2.3",
    "@nestjs/throttler": "^6.2.1",
    "@prisma/client": "^5.18.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "bcryptjs": "^2.4.3",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "bullmq": "^5.12.0",
    "@nestjs/bullmq": "^10.2.1",
    "socket.io": "^4.7.5",
    "ioredis": "^5.4.1",
    "axios": "^1.7.4",
    "axios-retry": "^4.4.0",
    "fluent-ffmpeg": "^2.1.3",
    "minio": "^8.0.1",
    "archiver": "^7.0.1",
    "pdfkit": "^0.15.0",
    "nanoid": "^5.0.7",
    "pino": "^9.3.2",
    "nestjs-pino": "^4.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@podcast-platform/shared": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/testing": "^10.4.4",
    "@types/express": "^4.17.21",
    "@types/node": "^20.15.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.13.4",
    "@types/archiver": "^6.0.2",
    "@types/jest": "^29.5.12",
    "@types/supertest": "^6.0.2",
    "typescript": "^5.5.4",
    "prisma": "^5.18.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "pino-pretty": "^11.2.2"
  }
}
