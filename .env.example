# ====== Deployment (Render / Vercel) ======
# CORS_ORIGINS: comma-separated list of allowed origins
# Dev: http://localhost:5173
# Prod: https://<your>.vercel.app
CORS_ORIGINS=http://localhost:5173

# JWT_SECRET: 必须设置为 32+ 位随机字符串，生产环境务必修改
# 可用命令生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# JWT_REFRESH_SECRET: 可选，如不设置则复用 JWT_SECRET
# 生产环境建议单独设置，增强刷新令牌安全性
JWT_REFRESH_SECRET=

# ====== Backend ======
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/podcast
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# MinIO (local dev) / OSS (prod)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=podcast
MINIO_USE_SSL=false

OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=
OSS_REGION=
OSS_CDN_DOMAIN=

# Third-party (leave API key empty for mock fallback)
LLM_PROVIDER=mimo
LLM_API_KEY=
LLM_ENDPOINT=https://token-plan-sgp.xiaomimimo.com/v1
LLM_MODEL=mimo-v2.5-pro
LLM_MAX_COMPLETION_TOKENS=4096
LLM_TOP_P=0.9

# 封面识别 LLM Vision (agnes-2.0-flash, 免费, OpenAI 兼容)
# 用于 /scan 页面拍摄封面识别书名+作者，留空则识别不可用（前端提示手动输入书名）
# 文档：https://agnes-ai.com/zh-Hans/docs/agnes-20-flash
LLM_VISION_ENDPOINT=https://apihub.agnes-ai.com/v1
LLM_VISION_API_KEY=
LLM_VISION_MODEL=agnes-2.0-flash

# Xiaomi MiMo / Token Plan TTS. Defaults reuse LLM_API_KEY and LLM_ENDPOINT.
MIMO_TTS_API_KEY=
MIMO_TTS_ENDPOINT=https://token-plan-sgp.xiaomimimo.com/v1
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_FORMAT=wav

# Legacy fallback only. Prefer LLM_* for Xiaomi MiMo / Token Plan.
DOUBAO_API_KEY=
DOUBAO_ENDPOINT=
DOUBAO_MODEL=

VOLC_TTS_APP_ID=
VOLC_TTS_TOKEN=
VOLC_TTS_CLUSTER=volcano_tts

AZURE_TTS_KEY=
AZURE_TTS_REGION=eastasia

OPENLIBRARY_BASE=https://openlibrary.org
GOOGLE_BOOKS_BASE=https://www.googleapis.com/books/v1
GOOGLE_API_KEY=
BOOKRANK_API_BASE_URL=https://bookrank-ckml.onrender.com

# App
PORT=3001
LOG_LEVEL=info
MAX_RETRY=3
MAX_BOOKS_PER_PROJECT=20
MAX_SCRIPT_WORDS=3000
MAX_SCRIPT_DURATION_MS=900000
# local is acceptable for a single-instance MVP, but files are ephemeral on most free hosts.
# Use minio/OSS or a persistent disk before real production traffic.
STORAGE_DRIVER=minio
PDF_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc

# ====== Frontend ======
VITE_API_BASE_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001
VITE_DEFAULT_LANG=zh-CN
VITE_MAX_BOOKS=20
VITE_API_TIMEOUT_MS=90000
