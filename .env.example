# ====== Deployment (Render / Vercel) ======
# CORS_ORIGINS: comma-separated list of allowed origins
# Dev: http://localhost:5173
# Prod: https://<your>.vercel.app
CORS_ORIGINS=http://localhost:5173

# JWT_SECRET: 32+ char random string (use Render's "Generate" button)
JWT_SECRET=please-change-me-in-production

# ====== Backend ======
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/podcast
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# MinIO (local dev) / OSS (prod)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=podcast
MINIO_USE_SSL=false

OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=
OSS_REGION=
OSS_CDN_DOMAIN=

# Third-party (leave empty for mock fallback)
DOUBAO_API_KEY=
DOUBAO_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-pro-32k

VOLC_TTS_APP_ID=
VOLC_TTS_TOKEN=
VOLC_TTS_CLUSTER=volcano_tts

AZURE_TTS_KEY=
AZURE_TTS_REGION=eastasia

OPENLIBRARY_BASE=https://openlibrary.org
GOOGLE_BOOKS_BASE=https://www.googleapis.com/books/v1

# App
PORT=3001
LOG_LEVEL=info
MAX_RETRY=3
MAX_BOOKS_PER_PROJECT=20
MAX_SCRIPT_WORDS=3000
MAX_SCRIPT_DURATION_MS=900000
STORAGE_DRIVER=minio

# ====== Frontend ======
VITE_API_BASE_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001
VITE_DEFAULT_LANG=zh-CN
VITE_MAX_BOOKS=20
