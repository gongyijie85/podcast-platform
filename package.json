{
  "name": "podcast-platform",
  "version": "0.4.0",
  "private": true,
  "description": "ISBN -> AI Podcast automated production platform (monorepo root)",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "prisma:generate": "pnpm --filter backend run prisma:generate",
    "prisma:migrate": "pnpm --filter backend run prisma:migrate",
    "seed:bgm": "pnpm --filter backend run seed:bgm",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.9.0",
  "dependencies": {
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript-eslint": "^8.0.0"
  }
}
